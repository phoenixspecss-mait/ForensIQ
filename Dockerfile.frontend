# Stage 1: Build Flutter Web Application
FROM ghcr.io/cirrusci/flutter:stable AS builder

WORKDIR /app

# Copy dependency definitions
COPY frontend/pubspec.yaml frontend/pubspec.lock ./frontend/

WORKDIR /app/frontend
RUN flutter pub get

# Copy frontend source code
COPY frontend/ .

# Build Flutter Web release bundle with compile-time backend URL define
ARG API_BASE_URL=https://forensiq-backend.onrender.com
RUN flutter build web --release --dart-define=API_BASE_URL=${API_BASE_URL}

# Stage 2: Serve Web Assets using Lightweight Nginx Container
FROM nginx:alpine

# Copy built static files from builder stage
COPY --from=builder /app/frontend/build/web /usr/share/nginx/html

# Copy Nginx server configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose default HTTP port
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
