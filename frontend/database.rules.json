{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "scans": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$scanId": {
          ".validate": "newData.hasChildren(['id', 'agent', 'query', 'amount', 'time'])"
        }
      }
    },
    "certificates": {
      "$certId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "system_integrity": {
      ".read": "auth != null",
      ".write": false
    }
  }
}