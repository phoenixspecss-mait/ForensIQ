rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User-specific forensics scan media uploads (images, videos, audio)
    match /user_scans/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Forensics audit PDF reports & verification certificates
    match /reports/{certId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Default rule for authenticated users
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
